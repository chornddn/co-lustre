    {
      "id": "e88a1f4a7809eaa8c07fc1133732a1a2ed1a030f",
      "tag": "autogenerated:ai-review",
      "author": {
        "_account_id": 1345,
        "name": "Gerrit AI review for Lustre",
        "display_name": "AI review",
        "email": "gaireview@linuxhacker.ru",
        "username": "aireview",
        "status": "Contact Oleg Drokin (green@whamcloud.com) with any questions on this account"
      },
      "date": "2026-07-24 08:31:56.000000000",
      "message": "Patch Set 4:\n\n(1 comment)\n\nExperimental feature testing in progress, please pay attention to the comments\n\nSome concerns, see inline. As written the new per-OST cap has no effect on the racer test path: the value computed here is overridden by the RACER_LOV_MAX_STRIPECOUNT that lustre/tests/racer.sh already sets and exports, so the effective bound stays at LOV_MAX_STRIPE_COUNT. The cap likely needs to move into the wrapper.",
      "accounts_in_message": [],
      "_revision_number": 4
    }
  ],
