      },
      "date": "2026-11-12 14:30:22.000000000",
      "message": "Patch Set 4: Verified+1\n\nPassed enforced test review-ldiskfs-dne-arm on RHEL 8.10 / x86_64, Rocky 9.8 / aarch64 uploaded by Onyx Autotest 2 from onyx-180vm76: https://testing.whamcloud.com/test_sessions/dd04d90d-6656-49ea-8d7c-becd035c9eaf ran 5 tests.",
      "accounts_in_message": [],
