          }
        ],
        "author": {
          "name": "Sebastien Buisson",
          "email": "sbuisson@ddn.com",
          "date": "2025-10-21 16:11:30.000000000",
          "tz": 120
        },
        "committer": {
          "name": "Sebastien Buisson",
          "email": "sbuisson@ddn.com",
          "date": "2026-06-08 13:28:54.000000000",
          "tz": 120
        },
        "subject": "LU-19079 krb: use .lgss to specify principal",
        "message": "LU-19079 krb: use .lgss to specify principal\n\nAllow the .lgss file inside the client mount point to contain a\nreference to the Kerberos principal to use, with the syntax:\nkrb5princ=<full Service Principal Name>\n\nThis is an alternative to the 'krb5princ' mount option, designed for\neasier automated implementation.\n\nTest-Parameters: trivial\nTest-Parameters: testgroup=review-dne-selinux-ssk-part-1\nTest-Parameters: testgroup=review-dne-selinux-ssk-part-2\nTest-Parameters: kerberos=true testlist=sanity-krb5\nSigned-off-by: Sebastien Buisson <sbuisson@ddn.com>\nChange-Id: I1205f65faed3f60057e301b883ea646c88efcf88\nWas-Change-Id: I776908e0ecad51ec3b3b79e5b392f95815d2e569\nReviewed-by: Li Xi <lixi@ddn.com>\nReviewed-by: Marc Vef <mvef@whamcloud.com>\n"
      },
      "branch": "refs/heads/master"
    }
