                            <comment id="506189" author="JIRAUSER20802" created="Thu, 19 Nov 2026 18:41:42 +0000">&lt;p&gt;A small sanity test also reproduces this issue on main.&lt;/p&gt;
&lt;div class="code panel" style="border-width: 1px;"&gt;&lt;div class="codeContent panelContent"&gt;
&lt;pre class="code-java"&gt;
diff --git a/lustre/tests/sanity.sh b/lustre/tests/sanity.sh
index d574064c00..04874a358f 100755
--- a/lustre/tests/sanity.sh
+++ b/lustre/tests/sanity.sh
@@ -37138,6 +37138,27 @@ test_920()
 }
 run_test 920 &lt;span class="code-quote"&gt;"Test multy LUFID"&lt;/span&gt;
 
+test_921() {
+    (( MDSCOUNT == 1 )) || skip &lt;span class="code-quote"&gt;"1 MDT only"&lt;/span&gt;
+    (( MDS1_VERSION &amp;gt;= $(version_code 2.11.52) )) ||
+        skip &lt;span class="code-quote"&gt;"Need MDS version at least 2.11.52"&lt;/span&gt;
+
+    mkdir -p $DIR/$tdir || error &lt;span class="code-quote"&gt;"mkdir $tdir failed"&lt;/span&gt;
+    stack_trap &lt;span class="code-quote"&gt;"rm -rf $DIR/$tdir"&lt;/span&gt;
+    touch $DIR/$tdir/$tfile || error &lt;span class="code-quote"&gt;"touch $tdir/$tfile failed"&lt;/span&gt;
+
+    # Requesting &amp;gt;1 stripe on a 1-MDT filesystem must fail cleanly rather
+    # than clamping ldo_dir_stripe_count to 0 and hitting an MDS LBUG in
+    # lod_prep_lmv_md().
+    $LFS migrate -m 0 -c 2 $DIR/$tdir &amp;amp;&amp;amp;
+        error &lt;span class="code-quote"&gt;"migrate -m 0 -c 2 on 1-MDT should fail"&lt;/span&gt;
+
+    $LFS getdirstripe -H $DIR/$tdir 2&amp;gt;/dev/&lt;span class="code-keyword"&gt;null&lt;/span&gt; | grep -q migrating &amp;amp;&amp;amp;
+        error &lt;span class="code-quote"&gt;"$tdir left in migrating state"&lt;/span&gt;
+    stat $DIR/$tdir/$tfile &amp;gt; /dev/&lt;span class="code-keyword"&gt;null&lt;/span&gt; || error &lt;span class="code-quote"&gt;"stat $tdir/$tfile failed"&lt;/span&gt;
+}
+run_test 921 &lt;span class="code-quote"&gt;"migrate dir with multi-stripe count on single-MDT"&lt;/span&gt; &lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;</comment>
