<rss version="0.92"><channel><item>
            <title>[LU-20540] utils: lfs quota -d option is not supported</title>
                <link>https://jira.whamcloud.com/browse/LU-20540</link>
                <project id="10000" key="LU">Lustre</project>
                    <description>&lt;p&gt;manpage shows that we can define the column delimiter by `-d` or `–delimiter` but `-d` is not supported.&lt;/p&gt;
&lt;div class="code panel" style="border-width: 1px;"&gt;&lt;div class="codeContent panelContent"&gt;
&lt;pre class="code-java"&gt;
# lfs quota -a -u --delimiter , /mnt/lustre
Disk usr quotas
      Filesystem,  quota_id,  kbytes,  bquota,  blimit,  bgrace,   files,  iquota,  ilimit,  igrace,
     /mnt/lustre, quota_usr,       0,       0,       0,       -,       0,       0,       0,       -,
     /mnt/lustre,quota_2usr,       0,       0,       0,       -,       0,       0,       0,       -,
# lfs quota -a -u -d , /mnt/lustre
lfs quota: unrecognized option &lt;span class="code-quote"&gt;'-d'&lt;/span&gt;
Display disk usage and limits.
usage: quota [-q] [-v] [-h] [-o OBD_UUID|-o OST_IDX|-m MDT_IDX]
             [{-u|-g|-p} UNAME|UID|GNAME|GID|PROJID]
             [--blocks|--busage|--space]
             [--block-softlimit|--bsoftlimit]
             [--block-hardlimit|--bhardlimit]
             [--block-grace|--bgrace|--btime]
             [--delimiter DELIMITER]
             [--filesystem|--mount-point]
             [--inodes|--iusage]
             [--inode-softlimit|--isoftlimit]
             [--inode-hardlimit|--ihardlimit]
             [--inode-grace|--igrace|--itime]
             [--lqa LQA_NAME]
             [--pool OST_POOL_NAME]
             [MOUNT_POINT ...]
       quota -t {-u|-g|-p} [--pool OST_POOL_NAME] [MOUNT_POINT ...]
       quota [-hqv] {-U|-G|-P} [--pool OST_POOL_NAME] [MOUNT_POINT ...]
       quota -a {-u|-g|-p} [-n] [-s START_QID] [-e END_QID]
             [--show-root] [MOUNT_POINT ...]
 &lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;</description>
