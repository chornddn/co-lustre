<rss version="0.92"><channel><item>
            <title>[LU-20985] rename vs rename deadlock</title>
                <link>https://jira.whamcloud.com/browse/LU-20985</link>
                <project id="10000" key="LU">Lustre</project>
                    <description>&lt;div class="code panel" style="border-width: 1px;"&gt;&lt;div class="codeContent panelContent"&gt;
&lt;pre class="code-java"&gt;
test_2000() {
	local td=$DIR2/$tdir
	local td2=$DIR/$tdir/$tdir-2

	stack_trap &lt;span class="code-quote"&gt;"umount $MOUNT2"&lt;/span&gt;
	mount_client $MOUNT2 || error &lt;span class="code-quote"&gt;"mount_client on $MOUNT2 failed"&lt;/span&gt;

	test_mkdir -c1 -i0 $DIR2/$tdir || error &lt;span class="code-quote"&gt;"mkdir $td failed"&lt;/span&gt;
	mkdir $DIR/$tdir/$tdir-2 || error &lt;span class="code-quote"&gt;"mkdir $td2 failed"&lt;/span&gt;
	touch $DIR/$tdir/a
	touch $DIR/$tdir/$tdir-2/b
	$LFS path2fid $DIR/$tdir
	$LFS path2fid $DIR/$tdir/$tdir-2

	stat $DIR/$tdir/a $DIR/$tdir/$tdir-2/b \
		$DIR2/$tdir/a $DIR2/$tdir/$tdir-2/b &amp;gt;&amp;amp;/dev/&lt;span class="code-keyword"&gt;null&lt;/span&gt;

#define OBD_FAIL_MDS_RENAME     0x153
	do_facet mds1 $LCTL set_param fail_loc=0x153

	mrename $DIR1/$tdir/a $DIR1/$tdir/$tdir-2/b &amp;amp;
	local pid1=$!
	sleep 0.3
	mrename $DIR2/$tdir/$tdir-2/b $DIR2/$tdir/a &amp;amp;
	local pid2=$!

	do_facet mds1 $LCTL set_param fail_loc=0
	wait $PID1 $PID2
}
run_test 2000 &lt;span class="code-quote"&gt;"rename test"&lt;/span&gt;
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;</description>
