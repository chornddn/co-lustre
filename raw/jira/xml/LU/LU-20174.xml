<rss version="0.92"><channel><item>
            <title>[LU-20174] Check fp_thread_count &gt; 1 for pfind</title>
                <link>https://jira.whamcloud.com/browse/LU-20174</link>
                <project id="10000" key="LU">Lustre</project>
                    <description>&lt;p&gt;In llapi_find, we should check fp_thread_count &amp;gt; 1 to call parallel_find:&lt;/p&gt;
&lt;div class="preformatted panel" style="border-width: 1px;"&gt;&lt;div class="preformattedContent panelContent"&gt;
&lt;pre&gt;int llapi_find(char *path, struct find_param *param)                            
{                                                                               
        if (param-&amp;gt;fp_format_printf_str)                                        
                validate_printf_str(param);                                     
        if (param-&amp;gt;fp_thread_count)                                             
                return parallel_find(path, NULL, NULL, param);                  
        else                                                                    
                return param_callback(path, cb_find_init, cb_common_fini,       
                                      param);                                   
}
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;</description>
