<rss version="0.92"><channel><item>
            <title>[LU-20644] lfs quota has inconsistent output for default-usr</title>
                <link>https://jira.whamcloud.com/browse/LU-20644</link>
                <project id="10000" key="LU">Lustre</project>
                    <description>&lt;p&gt;&lt;tt&gt;--default-usr&lt;/tt&gt; behaves differently than &lt;tt&gt;-U&lt;/tt&gt; for querying single limits:&lt;/p&gt;
&lt;div class="preformatted panel" style="border-width: 1px;"&gt;&lt;div class="preformattedContent panelContent"&gt;
&lt;pre&gt;[root@node1 ~]# lfs quota --default-usr --block-hardlimit  /lustre/fs/client/
Disk default usr quota:
      Filesystem  bquota  blimit  bgrace  iquota  ilimit  igrace
/lustre/fs/client/       0 18014398509481983       -       0       0       -
[root@node1 ~]# lfs quota -U --block-hardlimit  /lustre/fs/client/
Disk default usr quota:
  blimit
18014398509481983
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;
&lt;p&gt;vs the project quotas:&lt;/p&gt;
&lt;div class="preformatted panel" style="border-width: 1px;"&gt;&lt;div class="preformattedContent panelContent"&gt;
&lt;pre&gt;[root@node1 ~]# lfs quota --default-prj --block-hardlimit  /lustre/fs/client/
Disk default prj quota:
  blimit
18014398509481983
[root@node1 ~]# lfs quota -P --block-hardlimit  /lustre/fs/client/
Disk default prj quota:
  blimit
18014398509481983
 &lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;
&lt;p&gt;or Groups:&lt;/p&gt;
&lt;div class="preformatted panel" style="border-width: 1px;"&gt;&lt;div class="preformattedContent panelContent"&gt;
&lt;pre&gt;[root@node1 ~]# lfs quota --default-grp --block-hardlimit  /lustre/fs/client/
Disk default grp quota:
  blimit
0
[root@node1 ~]# lfs quota -G --block-hardlimit  /lustre/fs/client/
Disk default grp quota:
  blimit
0
&lt;/pre&gt;
&lt;/div&gt;&lt;/div&gt;</description>
